# Python environments and tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Local ML data and artifacts (keep directory markers only)
/data/*
!/data/.gitkeep
/models/*
!/models/.gitkeep
mlruns/
mlartifacts/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Generated reports and artifacts (keep directory markers only)
/reports/evaluation/*
!/reports/evaluation/.gitkeep
/reports/scoring/*
!/reports/scoring/.gitkeep
/reports/quality/*
!/reports/quality/.gitkeep
/reports/quarantine/*
!/reports/quarantine/.gitkeep
/reports/drift/*
!/reports/drift/.gitkeep
/reports/post_deployment/*
!/reports/post_deployment/.gitkeep

# OS and editor files
.DS_Store
.idea/
.vscode/
